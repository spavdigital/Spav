---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getDict } from '../../i18n';
import { sortByMediaThenOrder } from '../../lib/work';
import { getCollection } from 'astro:content';

const dict = getDict('en');
const entries = sortByMediaThenOrder(
  await getCollection('work', ({ data }) => !data.draft && data.lang === 'en')
);
---

<BaseLayout
  lang="en"
  dict={dict}
  title="Work — Pedro Gabriel"
  description={dict.work.empty}
  enPath="/work"
  ptPath="/pt/work"
>
  <section class="container section">
    <h1>{dict.work.heading}</h1>
    <p class="intro">{dict.work.empty}</p>
    {entries.length > 0 && (
      <div class="stack">
        {entries.map((entry, index) => (
          <ProjectCard
            entry={entry}
            href={`/work/${entry.data.urlSlug ?? entry.id}`}
            dict={dict}
            layout="band"
            eager={index === 0}
          />
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .section {
    padding-block: 3rem 4rem;
  }

  .intro {
    max-width: 44rem;
    color: var(--color-text-muted);
    font-size: 1.02rem;
  }

  /* One card per row. The band layout only works at full width — squeezing
     two of them side by side puts the cover back at thumbnail size, which is
     the problem this page exists to fix. */
  .stack {
    display: grid;
    gap: 1.5rem;
    margin-top: 2rem;
  }
</style>
