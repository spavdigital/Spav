---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getDict } from '../i18n';

const dict = getDict('en');
---

<BaseLayout
  lang="en"
  dict={dict}
  title="Page not found — Pedro Gabriel"
  description={dict.notFound.text}
  enPath="/404"
  ptPath="/pt/404"
>
  <section class="container section">
    <h1>{dict.notFound.title}</h1>
    <p class="lead">{dict.notFound.text}</p>
    <a class="btn btn-primary" href="/work">{dict.notFound.cta}</a>
  </section>
</BaseLayout>

<style>
  .section {
    padding-block: 5rem;
    max-width: 40rem;
  }

  .lead {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: 2rem;
  }
</style>
