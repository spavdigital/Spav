---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ProjectCard from '../../../components/ProjectCard.astro';
import { getDict } from '../../../i18n';
import { getCollection } from 'astro:content';

const dict = getDict('pt');
const entries = (await getCollection('work', ({ data }) => !data.draft && data.lang === 'pt')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<BaseLayout
  lang="pt"
  dict={dict}
  title="Trabalhos — Pedro Gabriel"
  description={dict.work.empty}
  enPath="/work"
  ptPath="/pt/work"
>
  <section class="container section">
    <h1>{dict.work.heading}</h1>
    {entries.length === 0 ? (
      <p class="empty">{dict.work.empty}</p>
    ) : (
      <div class="grid">
        {entries.map((entry) => (
          <ProjectCard
            href={`/pt/work/${entry.data.urlSlug ?? entry.id}`}
            title={entry.data.title}
            engine={entry.data.engine}
            complexity={entry.data.complexity}
            summary={entry.data.summary}
            previewVideoUrl={entry.data.previewVideoUrl}
            previewPosterUrl={entry.data.previewPosterUrl}
          />
        ))}
      </div>
    )}
  </section>
</BaseLayout>

<style>
  .section {
    padding-block: 4rem;
  }

  .empty {
    max-width: 36rem;
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  .grid {
    display: grid;
    /* auto-fill (not auto-fit) keeps empty tracks instead of collapsing
       them, and capping the track at 26rem stops a lone card (or the last
       card in an uneven row) from stretching to fill the row. */
    grid-template-columns: repeat(auto-fill, minmax(16rem, 26rem));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
</style>
