---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { getDict } from '../../../i18n';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection(
    'work',
    ({ data }) => (import.meta.env.DEV || !data.draft) && data.lang === 'pt'
  );
  return entries.map((entry) => ({
    params: { slug: entry.data.urlSlug ?? entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const dict = getDict('pt');
const slug = entry.data.urlSlug ?? entry.id;
const isEmbeddableVideo = entry.data.videoUrl?.includes('youtube.com/embed') || entry.data.videoUrl?.includes('youtu.be');
---

<BaseLayout
  lang="pt"
  dict={dict}
  title={`${entry.data.title} — Pedro Gabriel`}
  description={entry.data.summary}
  enPath={`/work/${slug}`}
  ptPath={`/pt/work/${slug}`}
>
  <article class="container project">
    {entry.data.videoUrl && (
      <div class="video-wrap">
        {isEmbeddableVideo ? (
          <iframe
            src={entry.data.videoUrl}
            title={entry.data.title}
            allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
            allowfullscreen
            loading="lazy"
          ></iframe>
        ) : (
          <video controls src={entry.data.videoUrl}></video>
        )}
      </div>
    )}

    <p class="meta">{entry.data.engine} · {entry.data.complexity}</p>
    <h1>{entry.data.title}</h1>

    <section>
      <h2>{dict.project.whatItIs}</h2>
      <p>{entry.data.summary}</p>
    </section>

    <section>
      <h2>{dict.project.underTheHood}</h2>
      <Content />
    </section>

    <section class="proof">
      {entry.data.liveUrl && (
        <a class="btn btn-primary" href={entry.data.liveUrl}>{dict.project.tryIt}</a>
      )}
      {entry.data.repoUrl && (
        <a class="btn btn-secondary" href={entry.data.repoUrl}>{dict.project.source}</a>
      )}
    </section>

    <ul class="tags">
      {entry.data.tags.map((tag) => <li>{tag}</li>)}
    </ul>

    <p class="back"><a href="/pt/work">&larr; {dict.project.backToWork}</a></p>
  </article>
</BaseLayout>

<style>
  /*
    The article itself uses .container's full width (72rem) rather than a
    narrow column, so the code block below can span it. Everything else —
    video, heading, paragraphs, buttons, tags — gets its own max-width and
    re-centers within that wider article, so the page reads exactly as
    before except where a code block needs the extra room.
  */
  .project {
    padding-block: 3rem 5rem;
  }

  .video-wrap {
    max-width: 44rem;
    margin: 0 auto 2rem;
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface);
  }

  .video-wrap video,
  .video-wrap iframe {
    width: 100%;
    aspect-ratio: 16 / 9;
    display: block;
    border: 0;
  }

  .meta,
  h1 {
    max-width: 44rem;
    margin-inline: auto;
  }

  section {
    margin-block: 2rem;
  }

  /* :global() on h2/p is required for the same reason as pre below:
     <Content />'s markdown output (the "Under the hood" paragraphs) is
     rendered by a different component and never carries this page's
     scoping attribute, so a plain "section > p" silently fails to match
     it — even though the sibling "What it is" <p>, written directly in
     this file, would have matched fine on its own. */
  section :global(h2),
  section :global(p) {
    max-width: 44rem;
    margin-inline: auto;
  }

  /* The deliberate exception: code blocks span the full article width so
     the explanatory comments in them don't truncate at a narrow measure. */
  section :global(pre) {
    font-size: 13px;
    overflow-x: auto;
  }

  .proof {
    max-width: 44rem;
    margin-inline: auto;
    display: flex;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .tags {
    max-width: 44rem;
    margin-inline: auto;
  }

  .back {
    max-width: 44rem;
    margin-inline: auto;
    margin-top: 3rem;
    font-size: 0.9rem;
  }
</style>
