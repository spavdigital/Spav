---
import BaseLayout from '../../layouts/BaseLayout.astro';
import EnginesAndProcess from '../../components/EnginesAndProcess.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getDict } from '../../i18n';
import { getCollection } from 'astro:content';
import { sortByMediaThenOrder } from '../../lib/work';

const dict = getDict('pt');
const featuredWork = sortByMediaThenOrder(
  await getCollection('work', ({ data }) => !data.draft && data.lang === 'pt')
).slice(0, 3);
---

<BaseLayout
  lang="pt"
  dict={dict}
  title="Pedro Gabriel — Programador de sistemas de jogo"
  description={dict.home.sub}
  enPath="/"
  ptPath="/pt"
>
  <section class="hero container">
    <p class="eyebrow">{dict.home.eyebrow}</p>
    <h1>{dict.home.h1}</h1>
    <p class="sub">{dict.home.sub}</p>
    <p class="proof">{dict.home.proof}</p>
    <div class="cta-row">
      <a class="btn btn-primary" href="#contact">{dict.home.ctaPrimary}</a>
      <a class="btn btn-secondary" href="/pt/work">{dict.home.ctaSecondary}</a>
    </div>
  </section>

  <section class="availability container">
    <div class="cards">
      {dict.home.availability.cards.map((label) => (
        <div class="card">
          <p>{label}</p>
        </div>
      ))}
    </div>
    <p class="note">{dict.home.availability.note}</p>
    <p class="hours">{dict.home.availability.hours}</p>
  </section>

  <EnginesAndProcess dict={dict} />

  {featuredWork.length > 0 && (
    <section class="container selected-work">
      <h2>{dict.home.selectedWork.heading}</h2>
      <div class="grid">
        {featuredWork.map((entry) => (
          <ProjectCard
            entry={entry}
            href={`/pt/work/${entry.data.urlSlug ?? entry.id}`}
            dict={dict}
            layout="stack"
          />
        ))}
      </div>
      <p class="see-all"><a href="/pt/work">{dict.home.selectedWork.cta} &rarr;</a></p>
    </section>
  )}
</BaseLayout>

<style>
  .hero {
    padding-block: 5rem 3rem;
  }

  .hero h1 {
    max-width: 52rem;
  }

  .proof {
    max-width: 40rem;
    margin-top: 1rem;
    font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 0.85rem;
    line-height: 1.6;
    color: var(--color-text-muted);
  }

  .sub {
    max-width: 34rem;
    font-size: 1.15rem;
    color: var(--color-text-muted);
  }

  .cta-row {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    margin-top: 2rem;
  }

  .availability {
    padding-block: 2rem 4rem;
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1rem;
  }

  .cards .card {
    text-align: center;
    font-weight: 600;
  }

  .note {
    margin-top: 1.5rem;
    color: var(--color-text-muted);
    font-size: 0.95rem;
    margin-bottom: 0.35rem;
  }

  /* Working hours were only in the footer of a project page before, which is
     the last place a studio checking timezone overlap would look. */
  .hours {
    margin: 0;
    font-family: ui-monospace, "JetBrains Mono", "Cascadia Code", Consolas, monospace;
    font-size: 0.82rem;
    color: var(--color-accent-cyan);
  }

  .selected-work {
    padding-block: 2rem 4rem;
  }

  /* auto-fit + 1fr so three featured cards fill the row instead of leaving
     a dead third of the page on the right, and min() so a single card never
     forces horizontal overflow on a 320px screen. */
  .selected-work .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(17rem, 100%), 1fr));
    gap: 1.5rem;
    margin-top: 1.25rem;
  }

  .see-all {
    margin-top: 1.5rem;
  }
</style>
