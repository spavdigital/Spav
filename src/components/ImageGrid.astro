---
import { Image, getImage } from 'astro:assets';
import type { ImageMetadata } from 'astro';

export interface GridItem {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}

interface Props {
  items: GridItem[];
  labels: { close: string; prev: string; next: string };
  /** Columns at desktop width. 3 on /gallery, 2 inside a project page. */
  columns?: number;
}

const { items, labels, columns = 3 } = Astro.props;

// The lightbox opens an optimized large render, not the untouched original —
// a 4K Studio capture would otherwise be a multi-megabyte download on click.
const full = await Promise.all(
  items.map((item) =>
    getImage({
      src: item.src,
      width: Math.min(1800, item.src.width),
      format: 'webp',
      quality: 82,
    })
  )
);
---

<div class="image-grid" style={`--cols:${columns}`}>
  {items.map((item, i) => (
    <figure class="cell">
      <button
        type="button"
        class="thumb"
        data-lightbox
        data-full={full[i].src}
        data-alt={item.alt}
        data-caption={item.caption ?? ''}
        aria-label={item.alt}
      >
        <Image
          src={item.src}
          alt={item.alt}
          widths={[360, 560, 860]}
          sizes={`(max-width: 640px) 100vw, (max-width: 980px) 50vw, ${Math.round(100 / columns)}vw`}
          loading="lazy"
        />
      </button>
      {item.caption && <figcaption>{item.caption}</figcaption>}
    </figure>
  ))}
</div>

<script is:inline define:vars={{ labels }}>
  // Native <dialog>, no dependency. Built once per page in JS rather than
  // rendered per grid, so two grids on the same page can't produce two
  // dialogs with the same id.
  (() => {
    if (window.__spavLightbox) return;
    window.__spavLightbox = true;

    const items = Array.from(document.querySelectorAll('[data-lightbox]'));
    if (items.length === 0) return;

    const dialog = document.createElement('dialog');
    dialog.className = 'spav-lightbox';
    dialog.innerHTML = `
      <button type="button" class="lb-close" aria-label="${labels.close}">&times;</button>
      <button type="button" class="lb-nav lb-prev" aria-label="${labels.prev}">&#8249;</button>
      <img class="lb-img" alt="" />
      <p class="lb-caption"></p>
      <button type="button" class="lb-nav lb-next" aria-label="${labels.next}">&#8250;</button>
    `;
    document.body.appendChild(dialog);

    const img = dialog.querySelector('.lb-img');
    const caption = dialog.querySelector('.lb-caption');
    const prevBtn = dialog.querySelector('.lb-prev');
    const nextBtn = dialog.querySelector('.lb-next');
    let index = 0;
    let opener = null;

    const show = (i) => {
      index = (i + items.length) % items.length;
      const el = items[index];
      img.src = el.dataset.full;
      img.alt = el.dataset.alt || '';
      caption.textContent = el.dataset.caption || '';
      caption.hidden = !el.dataset.caption;
      const multiple = items.length > 1;
      prevBtn.hidden = !multiple;
      nextBtn.hidden = !multiple;
    };

    items.forEach((el, i) =>
      el.addEventListener('click', () => {
        opener = el;
        show(i);
        dialog.showModal();
      })
    );

    prevBtn.addEventListener('click', () => show(index - 1));
    nextBtn.addEventListener('click', () => show(index + 1));
    dialog.querySelector('.lb-close').addEventListener('click', () => dialog.close());

    // Click on the backdrop (i.e. on the dialog itself, outside the figure).
    dialog.addEventListener('click', (event) => {
      if (event.target === dialog) dialog.close();
    });

    dialog.addEventListener('keydown', (event) => {
      if (event.key === 'ArrowRight') show(index + 1);
      if (event.key === 'ArrowLeft') show(index - 1);
    });

    // Escape already closes a modal dialog natively; this just returns focus
    // to the thumbnail the visitor came from instead of the top of the page.
    dialog.addEventListener('close', () => {
      img.removeAttribute('src');
      if (opener) opener.focus();
    });
  })();
</script>

<style>
  .image-grid {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .cell {
    margin: 0;
  }

  .thumb {
    display: block;
    width: 100%;
    padding: 0;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--color-surface-2);
    cursor: zoom-in;
  }

  .thumb:hover {
    border-color: var(--color-accent-cyan);
  }

  .thumb :global(img) {
    width: 100%;
    height: 100%;
    aspect-ratio: 16 / 10;
    object-fit: cover;
    display: block;
  }

  figcaption {
    margin-top: 0.5rem;
    font-size: 0.82rem;
    color: var(--color-text-muted);
  }

  @media (max-width: 980px) {
    .image-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 640px) {
    .image-grid {
      grid-template-columns: 1fr;
    }
  }
</style>

<style is:global>
  /* Global, not scoped: the dialog is appended to <body> by the script above
     and so never carries this component's scoping attribute. */
  dialog.spav-lightbox {
    max-width: min(94vw, 1400px);
    max-height: 94vh;
    padding: 0.75rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    background: var(--color-surface);
    color: var(--color-text);
    overflow: visible;
  }

  dialog.spav-lightbox::backdrop {
    background: rgb(6 8 12 / 0.85);
  }

  dialog.spav-lightbox .lb-img {
    max-width: 100%;
    max-height: 82vh;
    width: auto;
    margin: 0 auto;
    border-radius: calc(var(--radius) - 0.25rem);
  }

  dialog.spav-lightbox .lb-caption {
    margin: 0.6rem 0 0;
    text-align: center;
    font-size: 0.85rem;
    color: var(--color-text-muted);
  }

  dialog.spav-lightbox .lb-close,
  dialog.spav-lightbox .lb-nav {
    position: absolute;
    z-index: 1;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    border-radius: 999px;
    border: 1px solid var(--color-border);
    background: var(--color-bg);
    color: var(--color-text);
    font-size: 1.4rem;
    line-height: 1;
    cursor: pointer;
  }

  dialog.spav-lightbox .lb-close:hover,
  dialog.spav-lightbox .lb-nav:hover {
    border-color: var(--color-accent-cyan);
    color: var(--color-accent-cyan);
  }

  dialog.spav-lightbox .lb-close {
    top: -1.1rem;
    right: -1.1rem;
  }

  dialog.spav-lightbox .lb-prev {
    left: -1.1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  dialog.spav-lightbox .lb-next {
    right: -1.1rem;
    top: 50%;
    transform: translateY(-50%);
  }

  @media (max-width: 640px) {
    dialog.spav-lightbox .lb-close {
      top: 0.4rem;
      right: 0.4rem;
    }

    dialog.spav-lightbox .lb-prev {
      left: 0.4rem;
    }

    dialog.spav-lightbox .lb-next {
      right: 0.4rem;
    }
  }
</style>
