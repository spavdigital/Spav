---
interface Props {
  href: string;
  title: string;
  engine: string;
  complexity: string;
  summary: string;
  previewVideoUrl?: string;
  previewPosterUrl?: string;
}

const { href, title, engine, complexity, summary, previewVideoUrl, previewPosterUrl } = Astro.props;
---

<a class="project-card card" href={href}>
  {previewVideoUrl && (
    <video
      class="preview"
      src={previewVideoUrl}
      poster={previewPosterUrl}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    ></video>
  )}
  {previewVideoUrl && previewPosterUrl && (
    <img class="preview preview-static" src={previewPosterUrl} alt="" loading="lazy" />
  )}
  <p class="meta">{engine} · {complexity}</p>
  <h2>{title}</h2>
  <p>{summary}</p>
</a>

<style>
  .project-card {
    display: block;
    color: var(--color-text);
    overflow: hidden;
  }

  .project-card:hover {
    border-color: var(--color-accent-cyan);
    text-decoration: none;
  }

  .preview {
    width: calc(100% + 3rem);
    margin: -1.5rem -1.5rem 1rem;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-surface-2);
  }

  .preview-static {
    display: none;
  }

  /* Users who've asked for less motion get the poster frame only — the
     video is removed from the render tree (not just paused), which stops
     browsers from decoding it in the background. */
  @media (prefers-reduced-motion: reduce) {
    video.preview {
      display: none;
    }

    .preview-static {
      display: block;
    }
  }

  .meta {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }
</style>
