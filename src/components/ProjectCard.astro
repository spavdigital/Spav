---
interface Props {
  href: string;
  title: string;
  engine: string;
  complexity: string;
  summary: string;
  previewVideoUrl?: string;
}

const { href, title, engine, complexity, summary, previewVideoUrl } = Astro.props;
---

<a class="project-card card" href={href}>
  {previewVideoUrl && (
    <video
      class="preview"
      src={previewVideoUrl}
      autoplay
      muted
      loop
      playsinline
      preload="metadata"
    ></video>
  )}
  <p class="meta">{engine} · {complexity}</p>
  <h3>{title}</h3>
  <p>{summary}</p>
</a>

<style>
  .project-card {
    display: block;
    color: var(--color-text);
    overflow: hidden;
  }

  .project-card:hover {
    border-color: var(--color-accent-cyan);
    text-decoration: none;
  }

  .preview {
    width: calc(100% + 3rem);
    margin: -1.5rem -1.5rem 1rem;
    display: block;
    aspect-ratio: 16 / 9;
    object-fit: cover;
    background: var(--color-surface-2);
  }

  .meta {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--color-text-muted);
    margin-bottom: 0.5rem;
  }
</style>
