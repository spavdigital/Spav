---
import LangSwitch from './LangSwitch.astro';
import type { Dict, Lang } from '../i18n';

interface Props {
  lang: Lang;
  dict: Dict;
  enPath: string;
  ptPath: string;
}

const { lang, dict, enPath, ptPath } = Astro.props;
const prefix = lang === 'pt' ? '/pt' : '';
---

<header class="site-header">
  <div class="container inner">
    <a href={lang === 'pt' ? '/pt' : '/'} class="logo">
      <img class="logo-full" src="/logo-horizontal-1600.png" alt="Pedro Gabriel" width="1600" height="719" />
      <img class="logo-mark" src="/favicon-192.png" alt="Pedro Gabriel" width="192" height="192" />
    </a>
    <nav class="site-nav" aria-label="Main">
      <a href={lang === 'pt' ? '/pt' : '/'}>{dict.nav.home}</a>
      <a href={`${prefix}/work`}>{dict.nav.work}</a>
      <a href={`${prefix}/services`}>{dict.nav.services}</a>
      <a href={`${prefix}/about`}>{dict.nav.about}</a>
    </nav>
    <LangSwitch lang={lang} enPath={enPath} ptPath={ptPath} />
  </div>
</header>

<style>
  .site-header {
    border-bottom: 1px solid var(--color-border);
    background: var(--color-bg);
  }

  .inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 1rem;
  }

  .logo {
    flex-shrink: 0;
    display: flex;
    align-items: center;
  }

  .logo img {
    width: auto;
    max-width: none;
  }

  .logo-full {
    height: 2.75rem;
  }

  .logo-mark {
    height: 2.25rem;
    display: none;
  }

  .site-nav {
    display: flex;
    gap: 1.5rem;
    font-size: 0.95rem;
    font-weight: 500;
  }

  .site-nav a {
    color: var(--color-text);
  }

  .site-nav a:hover {
    color: var(--color-accent-cyan);
  }

  @media (max-width: 640px) {
    .inner {
      gap: 0.75rem;
    }

    .site-nav {
      gap: 0.65rem;
      font-size: 0.8rem;
    }

    .logo-full {
      display: none;
    }

    .logo-mark {
      display: block;
    }
  }
</style>
