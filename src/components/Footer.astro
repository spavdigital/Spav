---
import type { Dict, Lang } from '../i18n';

interface Props {
  lang: Lang;
  dict: Dict;
}

const { lang, dict } = Astro.props;
const whatsapp = lang === 'pt' ? (dict.contact as any).whatsapp as string | undefined : undefined;
const whatsappLabel = lang === 'pt' ? (dict.contact as any).whatsappLabel as string | undefined : undefined;
const whatsappHref = whatsapp ? `https://wa.me/${whatsapp.replace(/[^\d]/g, '')}` : undefined;
---

<footer class="site-footer" id="contact">
  <div class="container">
    <h2>{dict.contact.heading}</h2>
    <div class="contact-grid">
      <div>
        <p class="label">{dict.contact.discordLabel}</p>
        <button
          type="button"
          class="copy-btn"
          data-copy-value={dict.contact.discord}
          data-default-label={dict.contact.discord}
          data-copied-label={dict.contact.copiedLabel}
        >
          <span class="copy-btn-text">{dict.contact.discord}</span>
        </button>
      </div>
      <div>
        <p class="label">{dict.contact.emailLabel}</p>
        <p><a href={`mailto:${dict.contact.email}`}>{dict.contact.email}</a></p>
      </div>
      {whatsapp && (
        <div>
          <p class="label">{whatsappLabel}</p>
          <p><a href={whatsappHref}>{whatsapp}</a></p>
        </div>
      )}
      <div>
        <p class="label">{dict.contact.timezoneLabel}</p>
        <p>{dict.contact.timezone}</p>
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
    padding-block: 3rem;
    margin-top: 4rem;
  }

  .contact-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .label {
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--color-text-muted);
    margin-bottom: 0.25rem;
  }

  .copy-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    background: none;
    border: none;
    padding: 0;
    margin: 0;
    font: inherit;
    color: var(--color-text);
    cursor: pointer;
  }

  .copy-btn:hover {
    color: var(--color-accent-cyan);
  }

  .copy-btn.copied {
    color: var(--color-accent-cyan);
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('.copy-btn').forEach((btn) => {
    const textEl = btn.querySelector<HTMLSpanElement>('.copy-btn-text');
    const value = btn.dataset.copyValue ?? '';
    const defaultLabel = btn.dataset.defaultLabel ?? value;
    const copiedLabel = btn.dataset.copiedLabel ?? defaultLabel;
    let resetTimer: ReturnType<typeof setTimeout> | undefined;

    const showCopied = () => {
      if (textEl) textEl.textContent = copiedLabel;
      btn.classList.add('copied');
      clearTimeout(resetTimer);
      resetTimer = setTimeout(() => {
        if (textEl) textEl.textContent = defaultLabel;
        btn.classList.remove('copied');
      }, 1500);
    };

    const fallbackCopy = (text: string) => {
      const textarea = document.createElement('textarea');
      textarea.value = text;
      textarea.style.position = 'fixed';
      textarea.style.opacity = '0';
      document.body.appendChild(textarea);
      textarea.focus();
      textarea.select();
      try {
        document.execCommand('copy');
      } finally {
        document.body.removeChild(textarea);
      }
    };

    btn.addEventListener('click', async () => {
      try {
        if (navigator.clipboard && window.isSecureContext) {
          await navigator.clipboard.writeText(value);
        } else {
          fallbackCopy(value);
        }
      } catch {
        try {
          fallbackCopy(value);
        } catch {
          return;
        }
      }
      showCopied();
    });
  });
</script>
